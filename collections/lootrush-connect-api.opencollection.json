{
  "opencollection": "1.0.0",
  "info": {
    "name": "LootRush Partner Connect API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get consented user data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://third-party.lootrush.com/api/v1/consent/:consentId/user",
            "params": [
              {
                "name": "consentId",
                "value": "",
                "type": "path",
                "description": "Consent ID received after the user granted access."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves user data for a granted consent. Authenticated with an integration API key via the x-api-key header, not a bearer token."
        }
      ]
    }
  ],
  "bundled": true
}